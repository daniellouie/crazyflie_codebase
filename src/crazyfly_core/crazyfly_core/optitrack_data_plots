import csv, glob, re
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Ellipse
from pathlib import Path

# ---- Paths (adjust only this block if needed) ----
base = Path.home() / "Documents/GitHub/crazyflie_codebase"
stats_dir = base / "optitrack_data_stats"
raw_dir   = base / "optitrack_data_raw"

# ---- Helpers ----
ts_re = re.compile(r'(\d{4}-\d{2}-\d{2}_\d{2}:\d{2}:\d{2})')

def ts(name: str):
    m = ts_re.search(name)
    return m.group(1) if m else None

def first_row_csv(path):
    with open(path, newline='') as f:
        row = next(csv.DictReader(f), None)
        return {k.strip().lower(): (v.strip() if v is not None else v) for k, v in row.items()} if row else None

def iter_rows_csv(path):
    with open(path, newline='') as f:
        for row in csv.DictReader(f):
            yield {k.strip().lower(): (v.strip() if v is not None else v) for k, v in row.items()}

# ---- Find and pair files by timestamp ----
stats_files = list(stats_dir.glob("optitrack_data_*.csv"))
raw_files   = list(raw_dir.glob("optitrack_test_*.csv"))

pairs = {}
for p in stats_files:
    t = ts(p.name)
    if t: pairs.setdefault(t, {})["stats"] = p
for p in raw_files:
    t = ts(p.name)
    if t: pairs.setdefault(t, {})["raw"] = p

print(f"[INFO] candidate sessions: {len(pairs)}")
pairs = {t: pr for t, pr in pairs.items() if "stats" in pr and "raw" in pr}
print(f"[INFO] paired sessions:    {len(pairs)}")

# ---- Collect for plotting ----
true_pts = []
all_raw_x, all_raw_z = [], []
ellipses = []  # (center_x, center_z, width, height, angle_deg, (true_x,true_z), (mean_x,mean_z))

K = 2.0  # k-sigma ellipse (2σ)
for t, pr in sorted(pairs.items()):
    # True position from stats (first row)
    sr = first_row_csv(pr["stats"])
    if not sr or "x" not in sr or "z" not in sr:
        continue
    tx, tz = float(sr["x"]), float(sr["z"])
    true_pts.append((tx, tz))

    # Raw samples for this session
    xs, zs = [], []
    for r in iter_rows_csv(pr["raw"]):
        if "x" in r and "z" in r:
            try:
                xs.append(float(r["x"]))
                zs.append(float(r["z"]))
            except ValueError:
                pass

    if len(xs) < 2:  # need at least two samples to form covariance
        continue

    xs, zs = np.array(xs), np.array(zs)
    all_raw_x.extend(xs.tolist())
    all_raw_z.extend(zs.tolist())

    # Error cloud relative to true point
    dx, dz = xs - tx, zs - tz

    # Covariance -> principal axes (correctly tilted ellipse)
    cov = np.cov(np.vstack([dx, dz]))
    vals, vecs = np.linalg.eigh(cov)          # eigenvalues ascending
    order = np.argsort(vals)[::-1]            # sort descending
    vals, vecs = vals[order], vecs[:, order]

    # Std along principal axes
    s1, s2 = np.sqrt(np.maximum(vals[0], 0.0)), np.sqrt(np.maximum(vals[1], 0.0))
    # Full width/height = 2 * (K * std) = 2Kσ
    width, height = 2*K*s1, 2*K*s2

    # Orientation
    angle = np.degrees(np.arctan2(vecs[1, 0], vecs[0, 0]))

    # Center at measurement mean (or use (tx, tz) to center at the true point)
    mx, mz = float(np.mean(xs)), float(np.mean(zs))
    center = (mx, mz)  # change to (tx, tz) to center on the grid point

    ellipses.append((center[0], center[1], width, height, angle, (tx, tz), (mx, mz)))

# ---- Plot ----
plt.figure(figsize=(9, 9))
if true_pts:
    plt.scatter([p[0] for p in true_pts], [p[1] for p in true_pts],
                c='red', marker='s', s=25, label='True Grid')

if all_raw_x:
    plt.scatter(all_raw_x, all_raw_z, s=6, alpha=0.15, label='Raw Samples')

ax = plt.gca()
for cx, cz, w, h, ang, (tx, tz), (mx, mz) in ellipses:
    ell = Ellipse((cx, cz), width=w, height=h, angle=ang,
                  edgecolor='green', facecolor='none', lw=1.2, alpha=0.9)
    ax.add_patch(ell)
    # optional: show bias vector mean->true
    ax.plot([tx, mx], [tz, mz], ls='--', lw=1, alpha=0.6)

plt.title('Per-Point 2σ Error Ellipses (OptiTrack)')
plt.xlabel('X (m)'); plt.ylabel('Z (m)')
plt.axis('equal'); plt.grid(True); plt.legend()
plt.tight_layout()
plt.savefig('optitrack_per_point_ellipses.png', dpi=300)
plt.show()